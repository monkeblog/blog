---
layout: layouts/base.njk
---
{%- from "macros.njk" import postTags, authorLink %}
<h2>Latest posts</h2>
<ul class="post-list">
  {%- for post in collections.postsNewest | head(site.latestCount) %}
  <li>
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <div class="meta">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> ·
      {{ authorLink(post.data.author, authors) }}
    </div>
    {#- Preview: "summary" from front matter if set, otherwise the post's first paragraph #}
    {%- set preview = post.data.summary or (post.content | firstParagraph) %}
    {%- if preview %}
    <p class="summary">{{ preview | safe }}</p>
    {%- endif %}
    {{ postTags(post.data.tags) }}
  </li>
  {%- endfor %}
</ul>
<p class="more"><a href="/archive/">All posts →</a></p>
